{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**/*.js", "**/*.ts", "**/*.css", "**/*.json"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "rules": {
            "style": {
                "useConst": "error",
                "noDescendingSpecificity": "off"
            },
            "suspicious": {
                "noVar": "error",
                "noExplicitAny": "off"
            }
        }
    }
}
