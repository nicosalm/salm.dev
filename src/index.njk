<h2>Recent writing</h2>
<ul class="post-list">
    {%- for post in collections.posts | head(5) %}
    <li class="post-item">
        <a href="{{ post.url }}" class="post-link" data-description="{{ post.data.description | escape }}">{{ post.data.title }}</a>
        <span class="dot-leader"></span>
        <time class="post-date" datetime="{{ post.date | dateFormat }}">{{ post.date | monthYear }}</time>
    </li>
    {%- endfor %}
</ul>
