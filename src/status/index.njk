---
layout: layouts/base.njk
title: status
description: Uptime, traffic, bandwidth, and coding activity.
prefetch: https://status.salm.dev
---
<h1>Status</h1>

<div id="status-services">
    <p class="text-muted text-small">Loading...</p>
</div>

<h2>Domains</h2>
<div class="status-section">
    <div class="stat-row">
        <span class="stat-label"><a href="https://salm.dev">salm.dev</a></span>
        <span class="dot-leader"></span>
        <span class="stat-value"><span class="domain-status domain-active">active</span></span>
    </div>
    <div class="stat-row">
        <span class="stat-label">nico.blue</span>
        <span class="dot-leader"></span>
        <span class="stat-value"><span class="domain-status domain-parked">parked</span></span>
    </div>
    <div class="stat-row">
        <span class="stat-label">nicosalm.com</span>
        <span class="dot-leader"></span>
        <span class="stat-value"><span class="domain-status domain-parked">parked</span></span>
    </div>
    <div class="stat-row">
        <span class="stat-label">salm.sh</span>
        <span class="dot-leader"></span>
        <span class="stat-value"><span class="domain-status domain-parked">parked</span></span>
    </div>
</div>

<div id="status-analytics"></div>

<div id="status-coding"></div>

{% include "footer.njk" %}

<script src="/assets/js/status.js" defer></script>
