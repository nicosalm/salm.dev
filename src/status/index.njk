---
layout: layouts/base.njk
title: status
description: Uptime, traffic, and bandwidth.
prefetch: https://status.salm.dev
stylesheet: /styles/status.css
---
<div class="post-header">
    <h1>Status</h1>
    <p>{{ description }}</p>
</div>

<div class="panel-grid">
    <section class="panel" id="status-services">
        <p class="status-loading text-muted text-small">...loading</p>
        <noscript><style>.status-loading { display: none; }</style><p class="text-muted text-small">live status needs JavaScript</p></noscript>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Domains</h2></div>
        <div class="panel-rows">
            <div class="stat-row">
                <span class="stat-label"><a href="https://salm.dev">salm.dev</a></span>
                <span class="dot-leader"></span>
                <span class="stat-value"><span class="domain-active" id="salm-dev-renews">active</span></span>
            </div>
            <div class="stat-row">
                <span class="stat-label">nico.blue</span>
                <span class="dot-leader"></span>
                <span class="stat-value"><span class="domain-parked">parked</span></span>
            </div>
            <div class="stat-row">
                <span class="stat-label">nicosalm.com</span>
                <span class="dot-leader"></span>
                <span class="stat-value"><span class="domain-parked">parked</span></span>
            </div>
            <div class="stat-row">
                <span class="stat-label">salm.sh</span>
                <span class="dot-leader"></span>
                <span class="stat-value"><span class="domain-parked">parked</span></span>
            </div>
        </div>
    </section>

    <section class="panel panel-wide" id="status-incidents"></section>

    <section class="panel panel-wide" id="status-analytics"></section>
</div>

{% include "footer.njk" %}

<script src="{{ '/assets/js/status.js' | versioned }}" defer></script>
