---
layout: layouts/base.njk
---
<article>
    <h1>Now</h1>
    <p>This is a <a href="https://sive.rs/now2" target="_blank">now page</a>. Here's what I've been up to...</p>
    <h2>...in {{ date | monthYear }}</h2>
    {{ content | safe }}
    <div class="the-end">❦</div>
    {% include "post-reply.njk" %}
    <div class="post-navigation">
        {%- set previousNow = collections.nows | getPreviousCollectionItem(page) %}
        {%- set nextNow = collections.nows | getNextCollectionItem(page) %}
        {% if previousNow %}
        <div class="nav-prev">&lt;- <a href="{{ previousNow.url }}">{{ previousNow.data.date | monthYear }}</a></div>
        {% endif %}
        {% if nextNow %}
        <div class="nav-next"><a href="{{ nextNow.url }}">{{ nextNow.data.date | monthYear }}</a> -&gt;</div>
        {% endif %}
    </div>
    <nav class="now-archive" aria-label="Now pages">
        {%- set cov = collections.nows | coverage %}
        {%- set firstNow = collections.nows | first %}
        <p class="archive-title">Archive{% if cov %} (<abbr title="{{ cov.count }} of {{ cov.total }} months since {{ firstNow.date | monthName }} {{ firstNow.date | year }}">{{ cov.percent }}%</abbr>){% endif %}</p>
        <div class="archive-years">
            {%- for row in collections.nows | monthGrid %}
            <div class="archive-year">
                <span class="archive-year-label">{{ row.year }}</span>
                <div class="archive-months">
                    {%- for m in row.months %}
                    {%- set abbr = m.name.slice(0, 3) | lower %}
                    {%- if m.item %}<a href="{{ m.item.url }}" aria-label="{{ m.name }} {{ row.year }}"{% if m.item.url == page.url %} aria-current="page"{% endif %}>{{ abbr }}</a>
                    {%- else %}<span{% if m.outside %} class="outside"{% endif %} aria-hidden="true">{{ abbr }}</span>{% endif %}
                    {%- endfor %}
                </div>
            </div>
            {%- endfor %}
        </div>
    </nav>
</article>
{% include "footer.njk" %}
<script src="{{ '/assets/js/to-top.js' | versioned }}" defer></script>
