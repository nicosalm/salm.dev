<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f8f9fa" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="preload" href="/assets/fonts/rumiko-clear-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ '/styles/styles.css' | versioned }}">
    {%- if stylesheet %}
    <link rel="stylesheet" href="{{ stylesheet | versioned }}">
    {%- endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" type="application/rss+xml" title="writing | salm.dev" href="/rss.xml">
    <link rel="alternate" type="application/rss+xml" title="now | salm.dev" href="/now/rss.xml">
    <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description | default(site.description) }}">

    <meta property="og:title" content="{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ description | default(site.description) }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:creator" content="@salmdotdev">

    {% if prefetch %}
    <link rel="preconnect" href="{{ prefetch }}">
    {% endif %}
    {% if math %}
    <script src="{{ '/assets/js/mathjax-config.js' | versioned }}"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
    {% endif %}
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" id="top">
        <a href="/" class="site-title">salm.dev</a>
        <span class="spacer"></span>
        {%- set section = page.url.split("/")[1] %}
        <nav>
            {%- for item, href in [["writing", "/writing"], ["now", "/now"], ["misc", "/misc"], ["projects", "https://github.com/nicosalm"]] %}
            {%- if not loop.first %}<span class="sep">|</span>{% endif -%}
            <a href="{{ href }}"{% if href.startsWith("http") %} target="_blank"{% endif %}{% if section == item %} aria-current="page"{% endif %}>{{ item }}{% if item == "projects" %}<svg aria-hidden="true" focusable="false" viewBox="0 0 16 16"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>{% endif %}</a>
            {%- endfor %}
        </nav>
    </header>
    <main id="main">
    {{ content | safe }}
    </main>
    {%- if eleventy.env.runMode == "build" %}
    <script
        src="https://rybbit.salm.dev/api/script.js"
        data-site-id="81989c7adfe0"
        defer
    ></script>
    {%- endif %}
    <script src="https://instant.page/5.2.0" type="module" integrity="sha384-jnZyxPjiipYXnSU0ygqeac2q7CVYMbh84q0uHVRRxEtvFPiQYbXWUorga2aqZJ0z"></script>
    <script src="{{ '/assets/js/email.js' | versioned }}" defer></script>
    <script src="{{ '/assets/js/tooltips.js' | versioned }}" defer></script>
    <script src="{{ '/assets/js/console.js' | versioned }}" defer></script>
</body>
</html>
